{
  "name": "subly-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "generate-icon-safelist": "node scripts/generate-icon-safelist.mjs",
    "predev": "pnpm copy-assets && pnpm generate-icon-safelist",
    "dev": "vite",
    "prebuild": "pnpm copy-assets && pnpm generate-icon-safelist",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.0",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  },
  "packageManager": "pnpm@9.15.9"
}
